{
  "name": "@mheers/stirling-pdf-ui-components",
  "version": "0.1.0",
  "description": "Beautiful, accessible Vue 3 components for building Stirling PDF applications.",
  "keywords": [
    "pdf",
    "vue",
    "vue3",
    "components",
    "ui",
    "shadcn",
    "stirling-pdf",
    "pdf-viewer",
    "pdf-editor",
    "tailwindcss"
  ],
  "homepage": "https://github.com/mheers/stirling-pdf-ui-components#readme",
  "bugs": {
    "url": "https://github.com/mheers/stirling-pdf-ui-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mheers/stirling-pdf-ui-components.git"
  },
  "license": "MIT",
  "author": {
    "name": "Marcel Heers",
    "email": "marcel@heers.it",
    "url": "https://github.com/mheers"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/fix-dts.mjs",
    "build:storybook": "storybook build",
    "preview:storybook": "npx http-server storybook-static -p 6007 -c-1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm typecheck && pnpm test",
    "samples": "python3 scripts/generate-samples.py",
    "example:dev": "pnpm --filter @mheers/stirling-pdf-ui-example dev",
    "example:build": "pnpm --filter @mheers/stirling-pdf-ui-example build",
    "prepublishOnly": "pnpm build && pnpm test",
    "release": "npm publish"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "@lucide/vue": "^1.0.0",
    "pdfjs-dist": "^5.4.0 || ^6.0.0",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.74.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^31.0.1",
    "pdfjs-dist": "^6.5.438",
    "reka-ui": "^2.11.0",
    "storybook": "^10.6.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/react",
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@10.11.0"
}
